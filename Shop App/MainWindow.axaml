<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ShopApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="ShopApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Shop Database Owner"
        Width="900" Height="500"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto, *">

        <Border Grid.Row="0" Background="#f0f0f0" Padding="15" BorderBrush="LightGray" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="20">
                <TextBlock Text="Shop App - владелец базы данных" 
                           FontSize="18" 
                           FontWeight="Bold" 
                           VerticalAlignment="Center" 
                           Foreground="#333333"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="1"
                   Margin="20"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   FontSize="16"
                   Text="{Binding Status}"
                   TextWrapping="Wrap"/>
    </Grid>
</Window>
